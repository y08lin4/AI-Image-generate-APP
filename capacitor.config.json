{
  "appId": "com.ailinyu.aiimagegenerate",
  "appName": "LyAI生图工作台",
  "webDir": "www",
  "server": {
    "url": "https://ai-image.ailinyu.de/",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#f6f7fb",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#f6f7fb"
    }
  }
}
